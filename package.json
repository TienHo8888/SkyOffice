{
  "name": "skyoffice",
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "description": "Server for SkyOffice",
  "main": ".eslintrc.js",
  "scripts": {
    "start": "ts-node-dev --project server/tsconfig.server.json --respawn --transpile-only server/index.ts",
    "test:studio": "pnpm run test:store && pnpm run test:social && pnpm run test:presence && pnpm run test:casino && pnpm run test:texas && pnpm run test:tien-len && pnpm run test:world && pnpm run test:fishing && pnpm run test:work && pnpm run test:work-api",
    "test:store": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/store.test.ts",
    "test:social": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/social.test.ts",
    "test:presence": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/presence.test.ts",
    "test:casino": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/casino-rules.test.ts",
    "test:texas": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/texas-holdem.test.ts",
    "test:texas-multiplayer": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/texas-multiplayer-realtime.test.ts",
    "test:tien-len": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/tien-len.test.ts",
    "test:world": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/studio-world.test.ts",
    "test:fishing": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/fishing-housing.test.ts",
    "test:work": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/work.test.ts",
    "test:work-api": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register/transpile-only server/studio/work-api.test.ts",
    "test:party-realtime": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/party-realtime.test.ts",
    "test:work-realtime": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/work-realtime.test.ts",
    "test:tien-len-realtime": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/tien-len-realtime.test.ts",
    "test:game-chat-realtime": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/game-chat-realtime.test.ts",
    "test:rps-realtime": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/rps-realtime.test.ts",
    "test:realtime": "TS_NODE_PROJECT=server/tsconfig.server.json node -r ts-node/register server/studio/realtime.test.ts",
    "typecheck:server": "tsc --project server/tsconfig.server.json --noEmit",
    "build": "pnpm --dir client run build",
    "build:server": "tsc --project server/tsconfig.server.json",
    "start:prod": "node server/lib/server/index.js",
    "heroku-postbuild": "CI=true pnpm install --frozen-lockfile && CI=true pnpm --dir client install --frozen-lockfile && pnpm --dir client run build && pnpm exec tsc --project server/tsconfig.server.json",
    "test": "pnpm run test:studio && pnpm run typecheck:server && pnpm --dir client run typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinshen56714/SkyOffice.git"
  },
  "keywords": [],
  "author": "kevinshen56714",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kevinshen56714/SkyOffice/issues"
  },
  "homepage": "https://github.com/kevinshen56714/SkyOffice#readme",
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "copyfiles": "^2.4.1",
    "eslint": "^7.11.0",
    "minimist": ">=1.2.2",
    "rimraf": "^2.7.1",
    "ts-node": "^8.1.0",
    "ts-node-dev": "^1.0.0-pre.63",
    "typescript": "^4.8.2"
  },
  "dependencies": {
    "@colyseus/command": "^0.1.7",
    "@colyseus/monitor": "^0.14.0",
    "@colyseus/schema": "^1.0.34",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/pg": "8.23.1",
    "chess.js": "1.0.0",
    "colyseus": "^0.14.0",
    "colyseus.js": "^0.14.12",
    "cors": "^2.8.5",
    "express": "^4.16.4",
    "pg": "8.23.0",
    "phaser": "^3.55.2",
    "regenerator-runtime": "^0.13.7",
    "typescript": "^4.8.2"
  }
}
