PORT=2567
JWT_SECRET=replace-with-a-long-random-secret
STUDIO_DB_PATH=./server/data/studio-db.json
VITE_SERVER_URL=ws://localhost:2567
# Optional explicit HTTP API origin. If omitted, VITE_SERVER_URL is converted
# from ws(s):// to http(s):// and /api is appended.
VITE_API_URL=http://localhost:2567/api

# Production server persistence. Keep this server-only; never prefix it with
# VITE_ and never add the database password to the client or Netlify build.
STUDIO_PERSISTENCE=local
STUDIO_ADMIN_EMAIL=admin@example.com
STUDIO_ADMIN_USERNAME=admin
STUDIO_ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-characters
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
STUDIO_STATE_ID=skyoffice-production
CORS_ORIGINS=http://localhost:5173

# Optional local-only fixture password. Leave unset to generate a process-local value.
STUDIO_TEST_PASSWORD=
